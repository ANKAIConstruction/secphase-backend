# ─────────────────────────────────────────────────────────────────
# SECOND PHASE CONSTRUCTION — BACKEND ENVIRONMENT CONFIG
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# ── EMAIL (SMTP) ──────────────────────────────────────────────────
# The email account that SENDS the notification (your SMTP account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@secphase.com
SMTP_PASS=your_gmail_app_password_here

# Where enquiry emails are delivered (can be same as SMTP_USER)
MAIL_TO=info@secphase.com

# Sender label shown in inbox
MAIL_FROM=Second Phase Website <info@secphase.com>

# ── FILE UPLOADS ──────────────────────────────────────────────────
# Max file size per upload in MB
MAX_FILE_MB=20

# Max number of files per submission
MAX_FILES=10

# Folder where uploaded files are saved on the server
UPLOAD_DIR=uploads

# ── SECURITY ──────────────────────────────────────────────────────
# Allowed frontend origin (no trailing slash)
# Development:  http://localhost:5500
# Production:   https://www.secphase.com
CORS_ORIGIN=https://www.secphase.com

# Rate limit: max form submissions per IP per 15 minutes
RATE_LIMIT_MAX=10
